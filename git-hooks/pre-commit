#!/usr/bin/env bash

set -euo pipefail

files=()
while IFS= read -r -d '' file; do
  files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.json' '*.jsonc' '*.md' '*.mjs' '*.ts' '*.yml' '*.yaml')

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

pnpm exec oxfmt --write --threads=1 "${files[@]}"
git add -- "${files[@]}"
