{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".artifacts/tsgo-cache/extensions.tsbuildinfo"
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*test-helpers.ts",
    "**/*test-harness.ts",
    "**/*test-support.ts",
    "extensions/**/src/test-support/**"
  ]
}
