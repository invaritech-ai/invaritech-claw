// Copy to LocalSigning.xcconfig for personal local signing overrides.
// This file is only an example and should stay committed.

ICLAW_CODE_SIGN_STYLE = Automatic
ICLAW_DEVELOPMENT_TEAM = YOUR_TEAM_ID

ICLAW_APP_BUNDLE_ID = ai.openclaw.client
ICLAW_SHARE_BUNDLE_ID = ai.openclaw.client.share
ICLAW_ACTIVITY_WIDGET_BUNDLE_ID = ai.openclaw.client.activitywidget
ICLAW_WATCH_APP_BUNDLE_ID = ai.openclaw.client.watchkitapp
ICLAW_WATCH_EXTENSION_BUNDLE_ID = ai.openclaw.client.watchkitapp.extension

// Leave empty with automatic signing.
ICLAW_APP_PROFILE =
ICLAW_SHARE_PROFILE =
ICLAW_WATCH_APP_PROFILE =
ICLAW_WATCH_EXTENSION_PROFILE =
