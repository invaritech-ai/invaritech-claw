{
  "name": "iclaw",
  "version": "2026.4.24",
  "description": "Headless API automation agent with a terminal operator console.",
  "license": "MIT",
  "bin": {
    "iclaw": "iclaw.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/",
    "iclaw.mjs"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli-entry": "./iclaw.mjs"
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "check": "pnpm tsgo && pnpm build && pnpm test",
    "check:changed": "node scripts/check-changed.mjs",
    "dev": "node scripts/run-node.mjs",
    "format": "oxfmt --write --threads=1",
    "format:check": "oxfmt --check --threads=1",
    "iclaw": "node scripts/run-node.mjs",
    "lint": "oxlint --deny-warnings src test",
    "start": "node scripts/run-node.mjs",
    "test": "node scripts/test-projects.mjs",
    "test:changed": "node scripts/test-projects.mjs --changed origin/main",
    "tsgo": "node scripts/run-tsgo.mjs -p tsconfig.core.json",
    "tsgo:all": "node scripts/run-tsgo.mjs -p tsconfig.json",
    "tsgo:prod": "node scripts/run-tsgo.mjs -p tsconfig.core.json"
  },
  "dependencies": {
    "@mariozechner/pi-tui": "0.70.2",
    "chalk": "^5.6.2",
    "express": "^5.2.1",
    "json5": "^2.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "oxfmt": "0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.21.1",
    "tsdown": "0.21.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "path-to-regexp": "8.4.0",
      "qs": "6.14.2",
      "minimatch": "10.2.4"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": []
  }
}
